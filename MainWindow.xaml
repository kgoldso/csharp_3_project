<mah:MetroWindow x:Class="_3_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        Title="CSV People Manager"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
        BorderThickness="1">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Import Section -->
        <GroupBox Header="{DynamicResource ImportHeader}" Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource ImportButton}"
                            Width="220"
                            Height="35"
                            Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                            Command="{Binding ImportCommand}"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="15,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"/>

                    <mah:ProgressRing IsActive="{Binding IsLoading}"
                                      Width="30"
                                      Height="30"
                                      Margin="15,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Search Filters Section -->
        <GroupBox Header="{DynamicResource SearchHeader}" Grid.Row="1" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource LabelFirstName}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource LabelLastName}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="{DynamicResource LabelCity}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="{DynamicResource LabelCountry}" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                             mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,10,10,0">
                    <TextBlock Text="{DynamicResource LabelDate}" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding FilterDate}"
                                mah:TextBoxHelper.ClearTextButton="True"/>
                </StackPanel>

                <Button Grid.Column="1" Grid.Row="1"
                        Content="{DynamicResource SearchButton}"
                        Width="120"
                        Height="35"
                        Margin="0,25,0,0"
                        Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                        Command="{Binding SearchCommand}"/>
            </Grid>
        </GroupBox>

        <!-- Results Section -->
        <GroupBox Header="{DynamicResource ResultsHeader}" Grid.Row="3" Margin="0,0,0,15">
            <DataGrid x:Name="PeopleGrid"
                      ItemsSource="{Binding SearchResults}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="10"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Binding="{Binding FirstName}" Width="*"/>
                    <DataGridTextColumn Binding="{Binding LastName}" Width="*"/>
                    <DataGridTextColumn Binding="{Binding SurName}" Width="*"/>
                    <DataGridTextColumn Binding="{Binding City}" Width="*"/>
                    <DataGridTextColumn Binding="{Binding Country}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Export Section -->
        <GroupBox Header="{DynamicResource ExportHeader}" Grid.Row="4">
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="{DynamicResource ExportExcelButton}"
                        Width="160"
                        Height="35"
                        Margin="0,0,10,0"
                        Style="{DynamicResource MahApps.Styles.Button.Square}"
                        Command="{Binding ExportExcelCommand}"/>

                <Button Content="{DynamicResource ExportXmlButton}"
                        Width="160"
                        Height="35"
                        Margin="0,0,20,0"
                        Style="{DynamicResource MahApps.Styles.Button.Square}"
                        Command="{Binding ExportXmlCommand}"/>

                <TextBlock Text="{DynamicResource ExportLanguageLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox Width="70"
                          Height="35"
                          ItemsSource="{Binding AvailableLanguages}"
                          SelectedItem="{Binding SelectedLanguage}"/>
            </StackPanel>
        </GroupBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding SearchResults.Count, StringFormat='Total results: {0}'}"
                           FontWeight="SemiBold"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</mah:MetroWindow>
