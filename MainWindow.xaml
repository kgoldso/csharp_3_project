<Window x:Class="_3_project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV Importer" Height="600" Width="900">
    <Grid Background="White">
        <StackPanel Margin="10">
            <!-- Import Section -->
            <TextBlock Text="1. Import CSV File" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Name="ImportButton" Content="Select and Import CSV" Padding="10,5" Background="Blue" Foreground="White" Width="150" Click="ImportButton_Click"/>
                <TextBlock Name="ImportStatusText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Green"/>
            </StackPanel>

            <!-- Search Section -->
            <TextBlock Text="2. Search Filters" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                    <TextBlock Text="First Name:" FontSize="11"/>
                    <TextBox Name="FirstNameFilter" Padding="5" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0,5,0">
                    <TextBlock Text="Last Name:" FontSize="11"/>
                    <TextBox Name="LastNameFilter" Padding="5" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5,0,5,0">
                    <TextBlock Text="City:" FontSize="11"/>
                    <TextBox Name="CityFilter" Padding="5" Height="25"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="5,0,0,0">
                    <TextBlock Text="Country:" FontSize="11"/>
                    <TextBox Name="CountryFilter" Padding="5" Height="25"/>
                </StackPanel>
            </Grid>

            <Button Name="SearchButton" Content="Search" Padding="10,5" Background="Green" Foreground="White" Width="100" Margin="0,0,0,10" Click="SearchButton_Click"/>

            <!-- Results Section -->
            <TextBlock Text="3. Results" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>
            <DataGrid Name="ResultsDataGrid" Height="250" AutoGenerateColumns="True" Margin="0,0,0,10"/>

            <!-- Export Section -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Name="ExportExcelButton" Content="Export to CSV" Padding="10,5" Background="Orange" Foreground="White" Width="120" Margin="0,0,5,0" Click="ExportExcelButton_Click"/>
                <Button Name="ExportXmlButton" Content="Export to XML" Padding="10,5" Background="Purple" Foreground="White" Width="120" Click="ExportXmlButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
